@startuml
title FEATURE-004 Password Reset - Activity

start
:Utilisateur ouvre /request-password-reset;
:Saisie email;
if (Email valide ?) then (oui)
  :Submit demande;
  if (API success ?) then (oui)
    :Afficher confirmation email envoyé;
  else (non)
    if (RATE_LIMIT_EXCEEDED ?) then (oui)
      :Afficher countdown + bouton désactivé;
    else (non)
      :Afficher message d'erreur métier;
    endif
  endif
else (non)
  :Afficher erreur de validation;
endif

:Utilisateur ouvre lien reset;
if (oobCode présent ?) then (oui)
  :Afficher formulaire nouveau mot de passe;
  :Submit nouveau mot de passe;
  if (Reset success ?) then (oui)
    :Afficher succès + CTA signin;
  else (non)
    if (EXPIRED/INVALID OOB ?) then (oui)
      :Rediriger /password-reset-failure;
    else (non)
      :Afficher erreur (ex: mot de passe faible);
    endif
  endif
else (non)
  :Rediriger /password-reset-failure;
endif

stop
@enduml
