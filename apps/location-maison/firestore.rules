rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isTransactionOperation() {
      return request.resource != null && 
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['credits', 'updatedAt']) &&
             request.resource.data.credits is number &&
             resource.data.credits is number &&
             request.resource.data.credits <= resource.data.credits &&
             request.resource.data.credits >= 0;
    }

    function currentUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isAnnouncer() {
      return isSignedIn() &&
             exists(currentUserPath()) &&
             get(currentUserPath()).data.roles.hasAny(['Announcer']);
    }

    function propertyPath(propertyId) {
      return /databases/$(database)/documents/properties/$(propertyId);
    }

    function ownsReferencedProperty(propertyId) {
      // Co-gestion (cf. properties ci-dessous) : un annonceur qui a revendiqué l'annonce
      // (claimedBy) peut lui rattacher un reel, au même titre que le créateur d'origine.
      return exists(propertyPath(propertyId)) &&
             (get(propertyPath(propertyId)).data.createdBy == request.auth.uid ||
              get(propertyPath(propertyId)).data.get('claimedBy', null) == request.auth.uid);
    }

    function isSafeUserSelfUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let roleChanged = changedKeys.hasAny(['roles']);
      return changedKeys.hasOnly([
          'firstname',
          'lastname',
          'pseudo',
          'searchableName',
          'phoneNumbers',
          'phoneNumberVerified',
          'callNumber',
          'whatsappNumber',
          'birthDate',
          'country',
          'metadata',
          'providers',
          'fcmTokens',
          'notificationParameter',
          'favoris',
          'state',
          'image',
          'updatedAt',
          'roles'
        ]) &&
        request.resource.data.uid == resource.data.uid &&
        (
          !roleChanged ||
          (
            resource.data.metadata.needsProfileCompletion == true &&
            request.resource.data.roles is list &&
            request.resource.data.roles.hasOnly(['User', 'Announcer']) &&
            request.resource.data.roles.hasAny(['User'])
          )
        );
    }

    function isValidUserCreate() {
      return request.resource.data.uid == request.auth.uid &&
        request.resource.data.credits == 3 &&
        request.resource.data.roles is list &&
        request.resource.data.roles.hasOnly(['User', 'Announcer']) &&
        request.resource.data.roles.hasAny(['User']);
    }

    match /users/{userId} {
      // Lecture : l'utilisateur peut lire son propre profil, ou lecture publique pour vérification
      allow read: if true;
      
      // Création : lors de l'inscription, l'utilisateur authentifié peut créer son propre document
      // L'uid dans les données doit correspondre à l'utilisateur authentifié, avec les crédits
      // d'accueil attendus et sans role sensible injecté côté client.
      allow create: if isSignedIn() && isValidUserCreate();
      
      // Mise à jour : l'utilisateur peut mettre à jour son propre profil
      allow update: if isSignedIn() && (
        // Le propriétaire peut modifier uniquement les champs non financiers/non sensibles.
        (request.auth.uid == resource.data.uid && isSafeUserSelfUpdate()) ||
        // Transaction client de dépense de crédits uniquement : jamais d'augmentation.
        (isTransactionOperation() && request.auth.uid == request.resource.data.uid)
      );
    }
    
    match /notifications/{notificationId} {
      allow read, update: if isSignedIn() && request.auth.uid == resource.data.uid;
    }
    
    match /properties/{propertyId} {
      allow read: if true;
      allow create: if isAnnouncer() &&
        request.auth.uid == request.resource.data.createdBy &&
        request.resource.data.moderationStatus == 'PENDING';
      // Co-gestion (auto-attribution par téléphone vérifié, cf listing-claim.service.ts) :
      // un compte revendicataire (claimedBy) a les mêmes droits d'édition/suppression que
      // le créateur d'origine (createdBy, souvent l'admin via l'import Apify). `claimedBy`
      // est absent sur les documents jamais revendiqués, d'où `get(..., null)` plutôt qu'un
      // accès direct qui échouerait sur un champ manquant.
      // Le propriétaire ne peut pas changer moderationStatus lui-même, sauf pour resoumettre
      // une annonce rejetée (REJECTED -> PENDING). Seul l'admin (Admin SDK, bypass ces rules)
      // peut approuver/rejeter. Note: corrige aussi resource.data.uid -> createdBy, le seul
      // champ réellement écrit sur les documents property (uid n'a jamais existé ici).
      allow update: if isAnnouncer() && (
        request.auth.uid == resource.data.createdBy ||
        request.auth.uid == resource.data.get('claimedBy', null)
      ) && (
        request.resource.data.moderationStatus == resource.data.moderationStatus ||
        (resource.data.moderationStatus == 'REJECTED' && request.resource.data.moderationStatus == 'PENDING')
      );
      allow delete: if isAnnouncer() && (
        request.auth.uid == resource.data.createdBy ||
        request.auth.uid == resource.data.get('claimedBy', null)
      );
    }
    
    match /suggestions/{suggestionId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /credit_transactions/{transactionId} {
      // Simplification des règles de lecture
      allow read: if isSignedIn() && request.auth.uid == resource.data.uid;
      
      // Création client uniquement pour les dépenses immédiates (fallback IA).
      // Les achats/crédits positifs passent par API routes/Cloud Functions (Admin SDK).
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.uid &&
        request.resource.data.type == 'spend' &&
        request.resource.data.status == 'success' &&
        request.resource.data.credits is number &&
        request.resource.data.credits < 0;

      // Mise à jour de transaction : uniquement serveur/Admin SDK.
      allow update: if false;
    }

    // Cadeaux (dons MoMo sur les réels) : écrits par les Cloud Functions,
    // lus via les API routes (Admin SDK). Aucun accès client — le donateur est
    // anonyme (pas d'uid) et le doc contient son numéro de téléphone.
    match /gift_transactions/{transactionId} {
      allow read, write: if false;
    }

    // Demandes de retrait du solde cadeaux : créées et lues via les API routes
    // authentifiées, traitées par le back-office admin. Aucun accès client.
    match /gift_withdrawals/{withdrawalId} {
      allow read, write: if false;
    }

    match /idempotency_keys/{idempotencyKeyId} {
      allow read, write: if false;
    }

    // Demandes de recherche : publiées par des visiteurs anonymes (pas d'uid),
    // écrites uniquement par les Cloud Functions (paiement) et les routes admin
    // (modération) — Admin SDK, bypass ces règles. Contrairement à
    // gift_transactions (personne ne les parcourt), la page publique
    // /demandes-recherche lit directement via le SDK client : lecture
    // conditionnée à moderationStatus == 'APPROVED' pour ne jamais exposer un
    // brouillon impayé ou en attente (contact WhatsApp, description) avant
    // validation admin.
    match /search_requests/{searchRequestId} {
      allow read: if resource.data.moderationStatus == 'APPROVED';
      allow create, update, delete: if false;
    }

    match /provinces/{provinceId} {
      allow read: if true;
      allow create, update: if isSignedIn();
    }
    
    match /cities/{cityId} {
      allow read: if true;
      allow create, update: if isSignedIn();
    }
    
    match /streets/{streetId} {
      allow read: if true;           
      allow create, update: if isSignedIn();  
    }

    match /reels/{reelId} {
      // Lecture : le créateur (suivi temps réel du traitement, étape 1) OU tout le monde une
      // fois APPROVED (flux public, étape 2) — mirror exact de properties ci-dessus
      // (`allow read: if true`), qui permet à /api/property/list d'utiliser le SDK client
      // côté serveur sans Admin SDK. Même logique ici pour /api/reels/feed.
      allow read: if (isSignedIn() && request.auth.uid == resource.data.createdBy) ||
        resource.data.moderationStatus == 'APPROVED';

      // Création : par l'annonceur, soit rattachée à une annonce qu'il possède, soit orpheline
      // (propertyId absent/null — visiteur sans annonce, voir CreateOrphanReelClient, rattachée
      // plus tard). Un réel démarre toujours PENDING/uploading (défense en profondeur, mirror du
      // pattern properties ci-dessus) — le client ne peut pas se déclarer déjà approuvé/traité.
      allow create: if isAnnouncer() &&
        request.auth.uid == request.resource.data.createdBy &&
        request.resource.data.moderationStatus == 'PENDING' &&
        request.resource.data.processingStatus == 'uploading' &&
        (
          !('propertyId' in request.resource.data) ||
          request.resource.data.propertyId == null ||
          ownsReferencedProperty(request.resource.data.propertyId)
        );

      // Rattachement a posteriori d'un réel orphelin : le créateur peut passer propertyId de
      // null à une annonce qu'il possède, une seule fois, rien d'autre ne change (même idiome
      // que isTransactionOperation() plus haut — diff().affectedKeys() restreint).
      allow update: if isAnnouncer() &&
        request.auth.uid == resource.data.createdBy &&
        resource.data.propertyId == null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['propertyId', 'updatedAt']) &&
        ownsReferencedProperty(request.resource.data.propertyId);

      // Suppression : uniquement l'API admin (Admin SDK, contourne ces règles) — jamais le client.
      allow delete: if false;
    }

    match /property_statistics/{statisticsId} {
      // Tracking : création publique pour permettre le tracking des vues/interactions
      allow create: if true;
      
      // Lecture : uniquement pour le propriétaire de la propriété
      allow read: if isSignedIn() && request.auth.uid == resource.data.propertyOwnerId;
      
      // Mise à jour : uniquement le système (via Cloud Functions ou Admin SDK)
      // Les mises à jour se font via les API routes qui vérifient l'authentification côté serveur
      allow update: if false; // Désactivé côté client, uniquement via API routes/Admin SDK
      
      // Suppression : uniquement le propriétaire
      allow delete: if isSignedIn() && request.auth.uid == resource.data.propertyOwnerId;
    }
  }
}
