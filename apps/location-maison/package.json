{
  "name": "location-maison",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' next build",
    "build:windows": "cross-env NODE_OPTIONS=\"--max-old-space-size=8096\" next build",
    "start": "next start",
    "dev:local": "cp .env.local.dev .env.local && next dev --turbopack",
    "build:local": "mv .env.local .env.local.backup && cp .env.local.prod .env.local && next build && mv .env.local.backup .env.local",
    "dev:vault": "VAULT_PATH=logisgabon/dev node scripts/vault/vault-run.mjs next dev --turbopack",
    "build:vault": "VAULT_PATH=logisgabon/prod node scripts/vault/vault-run.mjs next build",
    "test": "jest",
    "test:unit": "jest --testPathPattern='__tests__/(unit|actions|db|hooks|lib|services|property)'",
    "test:integration": "jest --testPathPattern='__tests__/integration'",
    "test:rules": "firebase emulators:exec --only firestore,storage \"jest --config jest.rules.config.ts --runInBand --coverage=false\"",
    "test:storage-rules": "firebase emulators:exec --only storage \"jest --config jest.rules.config.ts --runInBand --coverage=false __tests__/rules/storage.rules.test.ts\"",
    "test:emulator:api": "firebase emulators:exec --only firestore \"jest --config jest.config.ts --runInBand --coverage=false __tests__/integration/api-firestore-emulator.test.ts\"",
    "test:emulator:ads": "firebase emulators:exec --only firestore \"jest --config jest.config.ts --runInBand --coverage=false __tests__/integration/api-firestore-emulator.test.ts -t 'sert seulement la campagne eligible'\"",
    "test:emulator:stats": "firebase emulators:exec --only firestore \"jest --config jest.config.ts --runInBand --coverage=false __tests__/integration/api-firestore-emulator.test.ts -t 'deduplique les statistiques|sert seulement la campagne eligible'\"",
    "test:e2e": "playwright test",
    "test:e2e:dev": "E2E_ENV=dev npm run test:e2e:setup:dev && NEXTAUTH_URL=http://localhost:3001 NEXT_PUBLIC_APP_URL=http://localhost:3001 NEXT_PUBLIC_HOST=http://localhost:3001 PORT=3001 npm run dev",
    "test:e2e:preprod": "E2E_ENV=preprod npm run test:e2e:setup:preprod && PORT=3001 npm run dev",
    "test:e2e:prod": "E2E_ENV=prod npm run test:e2e:setup:prod && PORT=3001 npm run dev",
    "test:e2e:setup:dev": "node -e \"const fs = require('fs'); if (fs.existsSync('.env.local.dev')) { fs.copyFileSync('.env.local.dev', '.env.local'); console.log('✅ .env.local.dev copied to .env.local'); } else { console.error('❌ .env.local.dev not found. Run: cp documentation/setup/env.local.dev.template .env.local.dev'); process.exit(1); }\"",
    "test:e2e:setup:preprod": "node -e \"const fs = require('fs'); if (fs.existsSync('.env.local.preprod')) { fs.copyFileSync('.env.local.preprod', '.env.local'); console.log('✅ .env.local.preprod copied to .env.local'); } else { console.error('❌ .env.local.preprod not found. Run: cp documentation/setup/env.local.preprod.template .env.local.preprod'); process.exit(1); }\"",
    "test:e2e:setup:prod": "node -e \"const fs = require('fs'); if (fs.existsSync('.env.local.prod')) { fs.copyFileSync('.env.local.prod', '.env.local'); console.log('✅ .env.local.prod copied to .env.local'); } else { console.error('❌ .env.local.prod not found. Create it with your production Firebase credentials.'); process.exit(1); }\"",
    "test:e2e:run:dev": "E2E_ENV=dev playwright test",
    "test:e2e:lot5": "E2E_ENV=dev playwright test __tests__/e2e/lot5-ux-accessibility.spec.ts --project=chromium-desktop-dev",
    "test:e2e:lot5:screenshots": "LOT5_SCREENSHOT_PHASE=after E2E_ENV=dev playwright test __tests__/e2e/lot5-ux-accessibility.spec.ts --project=chromium-desktop-dev",
    "test:e2e:lot5b": "E2E_ENV=dev playwright test __tests__/e2e/lot5b-forms-auth-balance.spec.ts --project=chromium-desktop-dev --workers=1",
    "test:e2e:lot5b:screenshots": "LOT5B_SCREENSHOTS=1 E2E_ENV=dev playwright test __tests__/e2e/lot5b-forms-auth-balance.spec.ts --project=chromium-desktop-dev --workers=1",
    "test:e2e:lot5c": "E2E_ENV=dev playwright test __tests__/e2e/lot5c-transversal-surfaces.spec.ts --project=chromium-desktop-dev --workers=1",
    "test:e2e:lot5c:screenshots": "LOT5C_SCREENSHOTS=1 E2E_ENV=dev playwright test __tests__/e2e/lot5c-transversal-surfaces.spec.ts --project=chromium-desktop-dev --workers=1",
    "test:e2e:lot6b": "E2E_ENV=dev playwright test __tests__/e2e/lot6b-ad-serving.spec.ts --project=chromium-desktop-dev --workers=1",
    "test:e2e:lot8b": "E2E_ENV=dev playwright test __tests__/e2e/lot8b-property-forms.spec.ts --project=chromium-desktop-dev --workers=2",
    "test:e2e:lot8d": "E2E_ENV=dev playwright test __tests__/e2e/lot8d-reels-ux.spec.ts --project=chromium-desktop-dev --workers=1",
    "test:e2e:lot8e": "E2E_ENV=dev playwright test __tests__/e2e/lot8e-search-consultation.spec.ts --project=chromium-desktop-dev --workers=1",
    "test:e2e:geolocation": "E2E_ENV=dev playwright test __tests__/e2e/geolocation-canonical.spec.ts --project=chromium-desktop-dev --workers=1",
    "test:smoke:lot6a": "node scripts/test-lot6a-real-dev-credits.js",
    "test:smoke:lot6d": "node scripts/test-lot6d-real-dev-observability.js",
    "test:smoke:lot8b": "node scripts/test-lot8b-real-dev-property.js",
    "test:smoke:lot8c": "node scripts/test-lot8c-real-dev-reel.js",
    "test:e2e:run:preprod": "E2E_ENV=preprod playwright test",
    "test:e2e:run:prod": "E2E_ENV=prod playwright test --project=chromium-desktop-prod",
    "test:coverage": "jest --coverage --coverageReporters=text --coverageReporters=lcov --coverageReporters=html --coverageReporters=json-summary",
    "test:coverage:baseline": "jest --coverage --coverageReporters=text-summary --coverageReporters=json-summary --runInBand --silent",
    "check:env": "node scripts/check-env-firebase.js",
    "sync:env": "node scripts/sync-env-variables.js",
    "audit:seo": "node scripts/audit-seo.mjs",
    "test:ci": "jest --ci --runInBand --coverage --coverageReporters=text-summary --coverageReporters=json-summary --coverageReporters=lcov --reporters=default && node ../../scripts/check-location-maison-coverage.cjs application",
    "check:coverage": "node ../../scripts/check-location-maison-coverage.cjs application",
    "check:types": "tsc --noEmit",
    "location:migrate:dev": "node scripts/firebase/migrate-canonical-locations.mjs --project dev --bootstrap-osm",
    "location:migrate:dev:apply": "node scripts/firebase/migrate-canonical-locations.mjs --project dev --bootstrap-osm --apply --confirm-project location-maison-dev",
    "test:watch": "jest --watch",
    "email": "email dev --dir src/emails",
    "email:logos": "node scripts/create-email-logos.js",
    "test:gmail": "node scripts/test-gmail-config.js",
    "test:gmail:send": "node scripts/test-gmail-config.js --send-test",
    "test:email:direct": "node scripts/test-direct-email.js",
    "test:email:api": "node scripts/test-verification-email.js",
    "test:email:reset": "node scripts/test-password-reset-api.js",
    "test:email:production": "node scripts/test-production-ready.js",
    "test:email:signup": "node scripts/test-signup-flow.js",
    "test:email:complete": "node scripts/test-complete-system.js",
    "test:email:force": "node scripts/test-real-emails.js",
    "apify:v2:run": "node scripts/apify-facebook-cursor-v2/src/cli/run-job.js",
    "apify:v2:replay": "node scripts/apify-facebook-cursor-v2/src/cli/replay-job.js",
    "test:sms": "node scripts/test-sms-verification.js",
    "test:sms:page": "echo '🌐 Page de test SMS disponible sur: http://localhost:3000/test-sms'",
    "check:firebase": "node scripts/check-firebase-config.js",
    "help:sms": "echo '📱 Guides SMS disponibles:' && echo '  - PHONE_VERIFICATION_IMPLEMENTATION.md (Implémentation complète)' && echo '  - PHONE_VERIFICATION_USAGE_GUIDE.md (Guide d'utilisation)' && echo '  - Test en ligne: http://localhost:3000/test-sms'",
    "help:gmail": "echo '📚 Guides disponibles:' && echo '  - NOUVEAU_CLIENT_OAUTH2.md (Guide de création client OAuth2)' && echo '  - ENV_VARIABLES.md (Nouvelles variables environnement)' && echo '  - GMAIL_SETUP_GUIDE.md (Guide complet)' && echo '  - EMAIL_SETUP.md (Documentation technique)'"
  },
