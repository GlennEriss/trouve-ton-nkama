  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "dev:local": "cp .env.local.dev .env.local && next dev --turbopack",
    "build:local": "mv .env.local .env.local.backup && cp .env.local.prod .env.local && next build && mv .env.local.backup .env.local",
    "dev:vault": "VAULT_PATH=logisgabon/dev node scripts/vault/vault-run.mjs next dev --turbopack",
