# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log
firebase-debug.*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Vault
vault-data/
init.txt

# Scripts
/scripts/scrap/images
/scripts/download-img/images

# Large GeoJSON files
/public/data/gabon_polygons.geojson

# Firebase Service Account files (sensitive credentials)
# Ignore all JSON files but allow README.md
/services-account-firebase/**/*.json
/services-account-firebase/**/*.key
/services-account-firebase/**/*.pem

# Apify Facebook Cursor v2 artifacts
/scripts/apify-facebook-cursor-v2/data/raw/*.json
/scripts/apify-facebook-cursor-v2/data/staging/*.json
/scripts/apify-facebook-cursor-v2/data/reports/*.json
