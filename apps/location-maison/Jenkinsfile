pipeline {
    agent { docker { image 'node:20' } }

    stages {
        stage('Install & Test') {
            steps {
                sh 'npm ci'
                sh 'npm run lint'
                sh 'npm test -- --ci'
            }
        }

        stage('Build') {
            steps { sh 'npm run build' }
        }

    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check logs for details.'
        }
        cleanup {
            cleanWs()
        }
    }
}
