pipeline {
    /* 1️⃣  Un SEUL conteneur Node 20 réutilisé pour tous les stages */
    agent {
        docker {
            image 'node:20'
            /* garde le même conteneur pour éviter de perdre node_modules */
            reuseNode true
        }
    }

    stages {
        stage('Install') {
            steps {
                /* 2️⃣  Installe les dépendances avant de builder */
                sh 'npm ci'
            }
        }

        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }
    }

    post {
        success { echo '✅ Build réussi !' }
        failure { echo '❌ Build échoué – voir les logs' }
        cleanup { cleanWs() }
    }
}
