pipeline {
    agent { docker { image 'node:20' } }

    stages {
        stage('Build') {
            steps { sh 'npm run build' }
        }

    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check logs for details.'
        }
        cleanup {
            cleanWs()
        }
    }
}
