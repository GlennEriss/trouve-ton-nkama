@startuml
left to right direction
skinparam componentStyle rectangle

actor "Admin" as Admin

node "Vercel" {
  component "Next.js Admin App" as NextApp
  component "BFF API" as BFF
}

node "Google Cloud / Firebase" {
  database "Firestore" as Firestore
  database "Firebase Storage" as Storage
  component "Cloud Functions" as Functions
  queue "Pub/Sub" as PubSub
  database "BigQuery" as BigQuery
}

node "Redis Managed" {
  database "Redis" as Redis
}

cloud "External Sources" {
  component "Firebase Analytics API" as FirebaseAnalytics
  component "Vercel Analytics API" as VercelAnalytics
}

cloud "Observability" {
  component "Sentry" as Sentry
}

cloud "SCM / CI" {
  component "GitHub" as GitHub
  component "GitHub Actions" as GHA
}

Admin --> NextApp
NextApp --> BFF
BFF --> Firestore
BFF --> Storage
BFF --> Redis
BFF --> Sentry

BFF --> PubSub
PubSub --> Functions
Functions --> BigQuery
Functions --> Firestore

FirebaseAnalytics --> Functions
VercelAnalytics --> Functions

GitHub --> GHA
GHA --> NextApp
GHA --> Functions

@enduml
