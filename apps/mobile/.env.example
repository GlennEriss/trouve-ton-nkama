# URL publique par défaut (utile pour Expo Go, un appareil physique et les builds preview/prod).
EXPO_PUBLIC_API_BASE_URL=https://www.tonnkama.com

# App ID public existant de la PWA. Ne jamais ajouter FACEBOOK_CLIENT_SECRET ici.
EXPO_PUBLIC_FACEBOOK_APP_ID=1302423897547182
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=
# Activer seulement après configuration Meta, prebuild et reconstruction native.
EXPO_PUBLIC_FACEBOOK_LINKING_ENABLED=false

# Pour tester un serveur local depuis un simulateur iOS, utiliser par exemple :
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# Depuis un téléphone physique, utiliser l'IP LAN de la machine, jamais localhost :
# EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:3000
